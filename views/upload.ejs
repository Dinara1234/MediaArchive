<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Загрузка — Медиа архив</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1><a href="/">Медиа архив</a></h1>
    <nav>
      <span>Привет, <b><%= currentUser.login %></b>!</span>
        <a href="/my">Мои загрузки</a>       <!-- ← новая строка -->
      <a href="/">На главную</a>
      <a href="#" id="logout-link">Выйти</a>
    </nav>
  </header>

  <main>
    <h2>Загрузка медиафайлов</h2>

    <form id="upload-form" enctype="multipart/form-data">
      <!-- Drag&drop зона -->
      <div id="drop-zone">
        <p>Перетащите файлы сюда<br><span>или</span></p>
        <label for="file-input" class="btn">Выбрать файлы</label>
        <input type="file" id="file-input" name="files" multiple
               accept="image/*,video/*,audio/*" hidden>
      </div>

      <!-- Превью выбранных файлов -->
      <ul id="file-list"></ul>

      <!-- Метаданные -->
      <label>Описание</label>
      <textarea name="description" rows="3" placeholder="Необязательно"></textarea>

      <label>Теги (через запятую)</label>
      <input type="text" name="tags" placeholder="море, закат, отпуск">

      <label>Категория</label>
      <select name="categoryId">
        <option value="">— без категории —</option>
        <!-- Сюда можно подгружать категории из БД через AJAX -->
      </select>

      <label>
        <input type="checkbox" name="isPublic" checked>
        Публичное (видно всем)
      </label>

      <button type="submit" id="submit-btn">Загрузить</button>
    </form>

    <p id="message"></p>
    <div id="progress"></div>
  </main>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="/js/upload.js"></script>
  <script>
    $(function() {
      $('#logout-link').on('click', function(e) {
        e.preventDefault();
        $.post('/api/auth/logout', function() { window.location.href = '/'; });
      });
    });
  </script>
  <script src="/js/utils.js"></script>
</body>
</html>