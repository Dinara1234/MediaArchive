<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Медиа архив — Главная</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1><a href="/">Медиа архив</a></h1>
    <nav>
      <% if (currentUser) { %>
        <span>Привет, <b><%= currentUser.login %></b>!</span>
        <a href="/my">Мои загрузки</a>       <!-- ← новая строка -->
        <a href="/upload" class="btn-upload">⬆ Загрузить</a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin">Админ-панель</a>
        <% } %>
        <a href="#" id="logout-link">Выйти</a>
      <% } else { %>
        <a href="/login">Войти</a>
        <a href="/register">Регистрация</a>
      <% } %>
    </nav>
  </header>

  <main>
    <h2>Публичная лента</h2>

    <!-- Панель фильтров -->
    <div class="filters">
      <input type="text" id="search-q" placeholder="Поиск по названию...">
      <input type="date" id="search-date">
      <input type="text" id="search-tag" placeholder="Тег">
      <button id="search-btn">Найти</button>
      <button id="reset-btn">Сбросить</button>
    </div>

    <!-- Контейнер для карточек -->
    <div id="media-grid" class="media-grid">
      <p id="loading">Загрузка...</p>
    </div>
    <p id="empty" style="display:none; color:#888;">Ничего не найдено</p>
  </main>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="/js/index.js"></script>
  <script>
    $(function() {
      $('#logout-link').on('click', function(e) {
        e.preventDefault();
        $.post('/api/auth/logout', function() { window.location.href = '/'; });
      });
    });
  </script>
  <script src="/js/utils.js"></script>
</body>
</html>